# Ignore everything by default
*

# Allow specific directories and files needed for builds
!app/
!docker/
!Dockerfile
!dist/
!*.md
!*.yml
!*.yaml
!*.json
!*.js
!*.sh

# Ignore development files
.git
.gitignore
.DS_Store
node_modules/
*.log
*.tmp
.env
.env.local

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
